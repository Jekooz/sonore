<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      DESIGN_TOKENS.md — approved visual spec. Do not deviate without checking back.
      Pitch black by default; color only from album art and the single accent.
    -->

    <Color x:Key="AccentColor">#FA2D48</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#FA2D48" />
    <SolidColorBrush x:Key="BufferedBrush" Color="#8C8C8C" Opacity="0.45" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#000000" />

    <!-- Layered surfaces (per the upgrade spec): elevation must stay readable,
         pure black + near-black cards flattened depth. -->
    <SolidColorBrush x:Key="GlassBrush" Color="#141417" Opacity="0.96" />
    <SolidColorBrush x:Key="GlassStrongBrush" Color="#1C1C21" Opacity="0.97" />
    <SolidColorBrush x:Key="CardBrush" Color="#141417" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#1C1C21" />
    <SolidColorBrush x:Key="TokenBorderBrush" Color="#26262B" />
    <SolidColorBrush x:Key="TokenBorderStrongBrush" Color="#33333A" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8C8C8C" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#525252" />

    <x:Double x:Key="PageHeadlineSize">28</x:Double>
    <x:Double x:Key="SectionHeaderSize">18</x:Double>
    <x:Double x:Key="CardTitleSize">14</x:Double>
    <x:Double x:Key="SecondaryTextSize">13</x:Double>

    <CornerRadius x:Key="PillCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>

    <Style x:Key="PageHeadlineText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="CharacterSpacing" Value="-15" /> <!-- ≈ -0.4px at 28px headline per DESIGN_TOKENS -->
    </Style>

    <Style x:Key="SectionHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="CardTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
    </Style>

    <!-- Accent CTA (Sign in with Google etc.): accent fill, white text, pill shape. -->
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="20,8" />
    </Style>

</ResourceDictionary>
