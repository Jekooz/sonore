<Page x:Class="YtMusicClient.Views.CollectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="using:YtMusicClient.Services"
      Background="{ThemeResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: back, cover, and the collection's real metadata. -->
        <Grid Grid.Row="0" Padding="32,24,32,12" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Style="{StaticResource IconButtonStyle}"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Back"
                    ToolTipService.ToolTip="Back"
                    Click="BackButton_Click">
                <FontIcon Glyph="&#xE72B;" FontSize="16"
                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
            </Button>

            <Border x:Name="HeaderArtHost"
                    Grid.Column="1"
                    Width="168" Height="168"
                    CornerRadius="{StaticResource CardCornerRadius}">
                <Border.Background>
                    <ImageBrush x:Name="HeaderArt" Stretch="UniformToFill" />
                </Border.Background>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Spacing="6">
                <TextBlock x:Name="KindText" Style="{StaticResource MutedText}" />
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource PageHeadlineText}"
                           TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText"
                           Style="{StaticResource SecondaryText}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock x:Name="CountText" Style="{StaticResource MutedText}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!-- Loading / empty / error state, replaced by the tracklist. -->
            <StackPanel x:Name="StatusPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
                <ProgressRing x:Name="LoadingRing"
                              Width="36" Height="36"
                              IsActive="True"
                              Foreground="{ThemeResource AccentBrush}" />
                <TextBlock x:Name="ErrorText"
                           Style="{StaticResource SecondaryText}"
                           MaxWidth="440"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- The tracklist: one row per real track; a row plays that track. -->
            <ListView x:Name="TrackList"
                      Padding="24,0,24,88"
                      Visibility="Collapsed"
                      SelectionMode="None"
                      ScrollViewer.IsDeferredScrollingEnabled="True">
                <ListView.Resources>
                    <!-- Rows paint their own hover highlight; silence the default
                         ListViewItem chrome so a hovered row never double-highlights. -->
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                </ListView.Resources>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:CollectionTrackView">
                        <Button Style="{StaticResource RowButtonStyle}"
                                Click="TrackRow_Click"
                                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                            <Grid ColumnSpacing="14" Margin="0,4" MinHeight="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Number}"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" />

                                <Border Grid.Column="1"
                                        Width="44" Height="44"
                                        CornerRadius="6">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{x:Bind ThumbnailImage, Mode=OneWay}"
                                                    Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{StaticResource CardTitleText}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind ArtistText}"
                                               Style="{StaticResource MutedText}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>

                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind Duration}"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Floating play button, bottom-right: plays the whole collection
                 from the first track. Sits above the persistent player bar. -->
            <Button x:Name="PlayAllButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,28,28"
                    Width="64" Height="64"
                    CornerRadius="32"
                    Background="{ThemeResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Play collection"
                    ToolTipService.ToolTip="Play"
                    Click="PlayAllButton_Click">
                <FontIcon Glyph="&#xE768;" FontSize="22"
                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
            </Button>
        </Grid>
    </Grid>
</Page>
