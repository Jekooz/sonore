<UserControl
    x:Class="YtMusicClient.Views.Controls.BufferedSeekBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One bar, two segments: lighter fill = already buffered, accent fill = played.
         The whole 22px row is the hit target; the visible bar is 4px. -->
    <Grid x:Name="Root" Height="22" Background="Transparent"
          PointerPressed="Root_PointerPressed"
          PointerMoved="Root_PointerMoved"
          PointerReleased="Root_PointerReleased"
          PointerCanceled="Root_PointerCaptureLost"
          PointerCaptureLost="Root_PointerCaptureLost">

        <Border Height="4" CornerRadius="2"
                Background="{ThemeResource TokenBorderStrongBrush}"
                VerticalAlignment="Center" />
        <Rectangle x:Name="BufferedRect" Height="4" RadiusX="2" RadiusY="2"
                   Fill="{ThemeResource BufferedBrush}"
                   HorizontalAlignment="Left" VerticalAlignment="Center" />
        <Rectangle x:Name="PlayedRect" Height="4" RadiusX="2" RadiusY="2"
                   Fill="{ThemeResource AccentBrush}"
                   HorizontalAlignment="Left" VerticalAlignment="Center" />
        <Ellipse x:Name="Thumb" Width="12" Height="12"
                 Fill="White"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Left"
                 Margin="-6,0,0,0" />
    </Grid>
</UserControl>
