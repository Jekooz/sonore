<Page x:Class="YtMusicClient.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="using:YtMusicClient.Services"
      Background="{ThemeResource AppBackgroundBrush}"
      NavigationCacheMode="Enabled">

    <Grid Padding="32,24">
        <!-- Layout changes (hero appears, sections show/hide) ease instead
             of snapping. -->
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <RepositionThemeTransition />
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Greeting + account line -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
                       Style="{StaticResource PageHeadlineText}" />
            <TextBlock Text="{x:Bind ViewModel.AuthStatusText, Mode=OneWay}"
                       Style="{StaticResource SecondaryText}" />
        </StackPanel>

        <!-- Signed-out prompt: one click opens the embedded Google sign-in window -->
        <StackPanel x:Name="SignedOutPanel"
                    Grid.Row="1"
                    Spacing="12"
                    MaxWidth="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="Sign in to see your music"
                       Style="{StaticResource SectionHeaderText}"
                       HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Text="Connect your YouTube Music account to load your recommendations, playlists, liked songs, subscriptions and favorite artists — all inside this app." />
            <Button x:Name="SignInButton"
                    Content="Sign in with Google"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    CornerRadius="{StaticResource PillCornerRadius}"
                    Padding="20,8"
                    Click="SignInButton_Click" />
        </StackPanel>

        <!-- Signed-in content -->
        <ScrollViewer x:Name="ContentScroll"
                      Grid.Row="1"
                      Visibility="Collapsed">
            <StackPanel Spacing="24">
                <!-- Loaded rows slide + fade in rather than popping. -->
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="22" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <ProgressRing x:Name="LoadingRing" Width="36" Height="36" IsActive="False" Foreground="{ThemeResource AccentBrush}" />
                <TextBlock x:Name="ErrorText"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <!-- Hero banner: glass card around the first playable card of the
                     first home row. Glass is reserved for chrome like this
                     floating card per DESIGN_TOKENS. -->
                <Border x:Name="HeroCard"
                        Background="{ThemeResource GlassBrush}"
                        BorderBrush="{ThemeResource TokenBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="20"
                        Visibility="Collapsed">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Rounded art: the image paints as the border's
                             background, inside the rounded corners. -->
                        <Border x:Name="HeroArt"
                                Grid.Column="0"
                                Width="176" Height="176"
                                CornerRadius="{StaticResource CardCornerRadius}" />

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <TextBlock x:Name="HeroTitle"
                                       Style="{StaticResource SectionHeaderText}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="HeroSubtitle"
                                       Style="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap" />
                            <Button Content="Play"
                                    Style="{StaticResource AccentButtonStyle}"
                                    CornerRadius="{StaticResource PillCornerRadius}"
                                    Padding="20,8"
                                    HorizontalAlignment="Left"
                                    Click="HeroPlay_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Two columns: main tile rows + fixed-width rail -->
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="RailColumn" Width="250" />
                    </Grid.ColumnDefinitions>

                    <!-- Main column: one section per home row. Tiles are bare
                         (no card border) — the art speaks for itself. -->
                    <ItemsControl x:Name="HomeRows" Grid.Column="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:HomeRowView">
                                <StackPanel Spacing="12" Margin="0,0,0,12">
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{StaticResource SectionHeaderText}" />
                                    <ItemsControl ItemsSource="{x:Bind Contents}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel Orientation="Horizontal">
                                                    <ItemsStackPanel.ChildrenTransitions>
                                                        <TransitionCollection>
                                                            <EntranceThemeTransition FromVerticalOffset="16" />
                                                        </TransitionCollection>
                                                    </ItemsStackPanel.ChildrenTransitions>
                                                </ItemsStackPanel>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="services:HomeItemView">
                                                <!-- Click handler lives on the page; the row's DataContext is
                                                     the HomeItemView, so cards with a videoId start playback. -->
                                                <Button Style="{StaticResource CardButtonStyle}"
                                                        Margin="0,0,16,16"
                                                        Click="HomeCard_Click"
                                                        AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                                                    <StackPanel Width="108" Spacing="6">
                                                        <Border Width="108" Height="108"
                                                                CornerRadius="{StaticResource CardCornerRadius}">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{x:Bind ThumbnailImage, Mode=OneWay}"
                                                                            Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                        <TextBlock Text="{x:Bind Title}"
                                                                   Style="{StaticResource CardTitleText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxLines="1" />
                                                        <TextBlock Text="{x:Bind Subtitle}"
                                                                   Style="{StaticResource MutedText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxLines="1" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Rail: the last home row as a narrow vertical list.
                         Header is the row's real title from the backend. -->
                    <StackPanel x:Name="RailPanel"
                                Grid.Column="1"
                                Spacing="12"
                                Visibility="Collapsed">
                        <TextBlock x:Name="RailTitle"
                                   Style="{StaticResource SectionHeaderText}" />
                        <ItemsControl x:Name="RailItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:HomeItemView">
                                    <Button Style="{StaticResource RowButtonStyle}"
                                            Margin="0,0,0,4"
                                            Click="HomeCard_Click"
                                            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="44" Height="44"
                                                    CornerRadius="8">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{x:Bind ThumbnailImage, Mode=OneWay}"
                                                                Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <TextBlock Text="{x:Bind Title}"
                                                           Style="{StaticResource CardTitleText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                                <TextBlock Text="{x:Bind Subtitle}"
                                                           Style="{StaticResource MutedText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
