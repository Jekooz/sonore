<Page x:Class="YtMusicClient.Views.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="using:YtMusicClient.Services"
      Background="{ThemeResource AppBackgroundBrush}"
      NavigationCacheMode="Enabled">

    <Grid Padding="32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Your Library" Style="{StaticResource PageHeadlineText}" />

        <!-- Category pills: active = white bg + black text, matching nav styling -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <RadioButton Content="Playlists" GroupName="LibraryTabs" IsChecked="True"
                         Style="{StaticResource NavPillRadioButton}"
                         Checked="LibraryTab_Playlists" />
            <RadioButton Content="Artists" GroupName="LibraryTabs"
                         Style="{StaticResource NavPillRadioButton}"
                         Checked="LibraryTab_Artists" />
            <RadioButton Content="Albums" GroupName="LibraryTabs"
                         Style="{StaticResource NavPillRadioButton}"
                         Checked="LibraryTab_Albums" />
            <RadioButton Content="Liked songs" GroupName="LibraryTabs"
                         Style="{StaticResource NavPillRadioButton}"
                         Checked="LibraryTab_Liked" />
            <RadioButton Content="Subscriptions" GroupName="LibraryTabs"
                         Style="{StaticResource NavPillRadioButton}"
                         Checked="LibraryTab_Subscriptions" />
        </StackPanel>

        <!-- Signed-out prompt -->
        <StackPanel x:Name="SignedOutPanel"
                    Grid.Row="2"
                    Spacing="12"
                    MaxWidth="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock Text="Your library lives here"
                       Style="{StaticResource SectionHeaderText}"
                       HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Text="Sign in to see your playlists, liked songs, subscribed artists, saved albums and channel subscriptions." />
            <Button Content="Sign in with Google"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    CornerRadius="18"
                    Padding="20,8"
                    Click="SignInButton_Click" />
        </StackPanel>

        <!-- Signed-in content -->
        <ScrollViewer x:Name="ContentScroll" Grid.Row="2" Visibility="Collapsed">
            <StackPanel Spacing="16">
                <ProgressRing x:Name="LoadingRing" Width="36" Height="36" IsActive="False" />
                <TextBlock x:Name="ErrorText"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <!-- Playlists -->
                <StackPanel x:Name="PlaylistsView" Spacing="12">
                    <ItemsControl x:Name="PlaylistsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="170" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:PlaylistItemView">
                                <StackPanel Width="160" Spacing="6" Margin="0,0,10,14">
                                    <Border CornerRadius="{StaticResource CardCornerRadius}"
                                            Width="160" Height="160"
                                            Background="{ThemeResource GlassBrush}">
                                        <Image Stretch="UniformToFill"
                                               Source="{x:Bind ThumbnailUrl, Mode=OneWay}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{StaticResource CardTitleText}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Style="{StaticResource MutedText}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1">
                                        <Run Text="{x:Bind Count, Mode=OneWay}" />
                                        <Run Text="songs" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Artists -->
                <StackPanel x:Name="ArtistsView" Spacing="12" Visibility="Collapsed">
                    <ItemsControl x:Name="ArtistsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="170" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:ArtistItemView">
                                <StackPanel Width="160" Spacing="6" Margin="0,0,10,14">
                                    <Border CornerRadius="60"
                                            Width="120" Height="120"
                                            Background="{ThemeResource GlassBrush}"
                                            HorizontalAlignment="Left">
                                        <Image Stretch="UniformToFill"
                                               Source="{x:Bind ThumbnailUrl, Mode=OneWay}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Artist}"
                                               Style="{StaticResource CardTitleText}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Style="{StaticResource MutedText}" MaxLines="1">
                                        <Run Text="{x:Bind Subscribers, Mode=OneWay}" />
                                        <Run Text="subscribers" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Albums -->
                <StackPanel x:Name="AlbumsView" Spacing="12" Visibility="Collapsed">
                    <ItemsControl x:Name="AlbumsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="170" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:AlbumItemView">
                                <StackPanel Width="160" Spacing="6" Margin="0,0,10,14">
                                    <Border CornerRadius="{StaticResource CardCornerRadius}"
                                            Width="160" Height="160"
                                            Background="{ThemeResource GlassBrush}">
                                        <Image Stretch="UniformToFill"
                                               Source="{x:Bind ThumbnailUrl, Mode=OneWay}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{StaticResource CardTitleText}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind Year}"
                                               Style="{StaticResource MutedText}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Liked songs (rows) -->
                <StackPanel x:Name="LikedView" Spacing="8" Visibility="Collapsed">
                    <ItemsControl x:Name="LikedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:TrackItemView">
                                <Grid ColumnSpacing="12" Margin="0,4" Height="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="0.8*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="6" Background="{ThemeResource GlassBrush}">
                                        <Image Stretch="UniformToFill"
                                               Source="{x:Bind ThumbnailUrl, Mode=OneWay}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}"
                                               Style="{StaticResource CardTitleText}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ArtistText}"
                                               Style="{StaticResource SecondaryText}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Duration}"
                                               Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Subscriptions -->
                <StackPanel x:Name="SubscriptionsView" Spacing="12" Visibility="Collapsed">
                    <ItemsControl x:Name="SubscriptionsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="170" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:ArtistItemView">
                                <StackPanel Width="160" Spacing="6" Margin="0,0,10,14">
                                    <Border CornerRadius="60"
                                            Width="120" Height="120"
                                            Background="{ThemeResource GlassBrush}"
                                            HorizontalAlignment="Left">
                                        <Image Stretch="UniformToFill"
                                               Source="{x:Bind ThumbnailUrl, Mode=OneWay}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Artist}"
                                               Style="{StaticResource CardTitleText}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
