<Page x:Class="YtMusicClient.Views.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource AppBackgroundBrush}"
      NavigationCacheMode="Enabled">

    <StackPanel Padding="32,24" Spacing="16">
        <TextBlock Text="Your Library" Style="{StaticResource PageHeadlineText}" />
        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                   Text="Sign in to see your playlists, liked songs and albums." />
    </StackPanel>
</Page>
