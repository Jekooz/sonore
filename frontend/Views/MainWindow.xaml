<Window x:Class="YtMusicClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:YtMusicClient.Views.Controls">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator x:Name="ToggleAccel" Key="Space" IsEnabled="True" Invoked="ToggleAccel_Invoked" ScopeOwner="{x:Bind RootGrid}" />
            <KeyboardAccelerator x:Name="SeekBackAccel" Key="Left" Modifiers="None" IsEnabled="True" Invoked="SeekBackAccel_Invoked" ScopeOwner="{x:Bind RootGrid}" />
            <KeyboardAccelerator x:Name="SeekForwardAccel" Key="Right" Modifiers="None" IsEnabled="True" Invoked="SeekForwardAccel_Invoked" ScopeOwner="{x:Bind RootGrid}" />
            <KeyboardAccelerator x:Name="VolumeUpAccel" Key="Up" Modifiers="None" IsEnabled="True" Invoked="VolumeUpAccel_Invoked" ScopeOwner="{x:Bind RootGrid}" />
            <KeyboardAccelerator x:Name="VolumeDownAccel" Key="Down" Modifiers="None" IsEnabled="True" Invoked="VolumeDownAccel_Invoked" ScopeOwner="{x:Bind RootGrid}" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Two-column shell: fixed navigation sidebar + flexible content. The title
             bar and the persistent player bar span both columns. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Glass chrome: title bar + tab pill, per DESIGN_TOKENS (glass only on floating chrome). -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Grid.ColumnSpan="2"
              Height="48"
              Background="{ThemeResource GlassBrush}"
              BorderBrush="{ThemeResource TokenBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="32,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="22" Height="22"
                    CornerRadius="6"
                    Background="{ThemeResource AccentBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0" />
            <TextBlock Grid.Column="0"
                       Text="YT"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />

            <!-- Navigation moved out of the title bar into the sidebar below
                 (sidebar + flexible content + persistent bottom player). The title
                 bar keeps the brand mark and the account chip; the spacer column is
                 what holds the chip over on the right. -->

            <!-- Theme button & Account Chip -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,140,0">
                <Button x:Name="ThemeButton"
                        Style="{StaticResource IconButtonStyle}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Theme options"
                        ToolTipService.ToolTip="Change Theme">
                    <Button.Flyout>
                        <MenuFlyout Opened="ThemeFlyout_Opened">
                            <RadioMenuFlyoutItem x:Name="DarkThemeItem" Text="Dark Theme" Click="ThemeDark_Click" />
                            <RadioMenuFlyoutItem x:Name="LightThemeItem" Text="Light Theme" Click="ThemeLight_Click" />
                            <RadioMenuFlyoutItem x:Name="SystemThemeItem" Text="System Theme" Click="ThemeSystem_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE771;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>

                <!-- Signed out: quiet wordmark, clear of the caption buttons. -->
                <TextBlock x:Name="AppTitleText"
                           Text="YouTube Music"
                           VerticalAlignment="Center"
                           Style="{StaticResource MutedText}" />

                <!-- Signed in: account chip — real photo + name from the
                     backend /account response. Click opens the sign-out menu. -->
                <Button x:Name="AccountChip"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,4"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Account">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Sign out" Click="SignOut_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Letter fallback for accounts without a photo URL. -->
                    <Border x:Name="PhotoFallback"
                            Width="28" Height="28"
                            CornerRadius="14"
                            Background="{ThemeResource TokenBorderStrongBrush}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="AccountInitial"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <!-- Fill is set in code-behind (UpdateAccountChrome): a string→ImageSource
                         x:Bind here crashes the app on null/empty (E_INVALIDARG). -->
                    <Ellipse x:Name="AccountPhoto"
                             Width="28" Height="28"
                             Visibility="Collapsed" />
                    <TextBlock Text="{x:Bind ViewModel.AccountName, Mode=OneWay}"
                               Style="{StaticResource SecondaryText}"
                               MaxWidth="140"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </StackPanel>
        </Grid>

        <!-- Navigation sidebar: the same four RadioButtons, with the same x:Name,
             Tag and GroupName as the old title-bar pill, so the code-behind wiring
             (HomeTab.Checked += NavTab_Checked, NavTab_Tapped) and the programmatic
             selections (ShowNowPlaying, the sign-out flow) keep working untouched.
             Only the style and the column changed. -->
        <Border x:Name="NavSidebar"
                Grid.Row="1"
                Grid.Column="0"
                Width="196"
                Margin="12,4,0,12"
                Padding="8"
                CornerRadius="14"
                VerticalAlignment="Top"
                Background="{ThemeResource GlassBrush}"
                BorderBrush="{ThemeResource TokenBorderBrush}"
                BorderThickness="1">
            <StackPanel Spacing="2">
                <RadioButton x:Name="HomeTab" GroupName="NavTabs"
                             Style="{StaticResource NavSidebarRadioButton}"
                             Tag="home" Content="Home" IsChecked="True"
                             AutomationProperties.Name="Home" />
                <RadioButton x:Name="SearchTab" GroupName="NavTabs"
                             Style="{StaticResource NavSidebarRadioButton}"
                             Tag="search" Content="Search"
                             AutomationProperties.Name="Search" />
                <RadioButton x:Name="LibraryTab" GroupName="NavTabs"
                             Style="{StaticResource NavSidebarRadioButton}"
                             Tag="library" Content="Library"
                             AutomationProperties.Name="Library" />
                <RadioButton x:Name="NowPlayingTab" GroupName="NavTabs"
                             Style="{StaticResource NavSidebarRadioButton}"
                             Tag="nowplaying" Content="Now Playing"
                             AutomationProperties.Name="Now Playing" />
            </StackPanel>
        </Border>

        <!-- Compact navigation: visible ONLY while Now Playing replaces the
             sidebar (SetNavCollapsed). E700 is the three-line NavigationMenu
             glyph. Sits in row 1 / column 0 — below the title bar's drag
             region, exactly where the sidebar's top edge was — so it never
             overlaps the artwork or the transport, and being a real Button it
             stays clickable, focusable and named for accessibility. The flyout
             reuses the sidebar's Tag values, so one handler drives the existing
             Checked → NavigateToTab wiring instead of a second nav system. -->
        <Button x:Name="HamburgerButton"
                Grid.Row="1"
                Grid.Column="0"
                Width="44"
                Height="44"
                Padding="0"
                Margin="12,4,0,12"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Style="{StaticResource IconButtonStyle}"
                Visibility="Collapsed"
                AutomationProperties.Name="Navigation menu"
                ToolTipService.ToolTip="Navigation menu">
            <Button.Flyout>
                <MenuFlyout Placement="Bottom">
                    <MenuFlyoutItem Text="Home" Tag="home" Click="NavFlyoutItem_Click" />
                    <MenuFlyoutItem Text="Search" Tag="search" Click="NavFlyoutItem_Click" />
                    <MenuFlyoutItem Text="Library" Tag="library" Click="NavFlyoutItem_Click" />
                    <MenuFlyoutItem Text="Now Playing" Tag="nowplaying" Click="NavFlyoutItem_Click" />
                </MenuFlyout>
            </Button.Flyout>
            <FontIcon Glyph="&#xE700;" FontSize="16" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
        </Button>

        <!-- Page swap animation: NavigationThemeTransition eases each tab's
             content in/out instead of hard-cutting between pages. -->
        <Frame x:Name="ContentFrame" Grid.Row="1" Grid.Column="1">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <NavigationThemeTransition>
                        <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            <EntranceNavigationTransitionInfo />
                        </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    </NavigationThemeTransition>
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>

        <!-- Browser sign-in overlay: shown while /auth/browser/start is in
             flight. True-black glass scrim per DESIGN_TOKENS; a single card
             with the live state, a Cancel button, and the extension-install
             helper when the hand-off needs it. -->
        <Grid x:Name="BrowserSignInOverlay"
              Grid.Row="1"
              Grid.ColumnSpan="2"
              Background="#E6000000"
              Opacity="0"
              Visibility="Collapsed">
            <Border Background="{ThemeResource GlassStrongBrush}"
                    BorderBrush="{ThemeResource TokenBorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <StackPanel Spacing="12">
                    <ProgressRing x:Name="SignInRing"
                                  Width="32" Height="32"
                                  IsActive="True"
                                  Foreground="{ThemeResource AccentBrush}" />
                    <TextBlock x:Name="SignInHeadline"
                               Text="Waiting for you to sign in…"
                               Style="{StaticResource SectionHeaderText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SignInDetail"
                               Style="{StaticResource SecondaryText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button x:Name="OpenExtensionFolderButton"
                            Content="Open the helper extension folder"
                            Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="{StaticResource PillCornerRadius}"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Click="OpenExtensionFolder_Click" />
                    <Button x:Name="CancelSignInButton"
                            Content="Cancel"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource TokenBorderStrongBrush}"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            CornerRadius="{StaticResource PillCornerRadius}"
                            Padding="20,8"
                            HorizontalAlignment="Center"
                            Click="CancelSignIn_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Persistent player bar: rounded glass pill, per DESIGN_TOKENS.
             Glass rgba(255,255,255,0.10) with blur-equivalent dark tint,
             TokenBorderStrongBrush outline, and a diagonal specular highlight
             (120deg white gradient at ~0.16 opacity) on the leading edge. -->
        <Grid x:Name="PlayerBar"
              Grid.Row="2"
              Grid.ColumnSpan="2"
              Height="64"
              Margin="16,0,16,16"
              CornerRadius="18"
              Background="{ThemeResource GlassStrongBrush}"
              BorderBrush="{ThemeResource TokenBorderStrongBrush}"
              BorderThickness="1"
              Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Leading-edge specular sheen: a real soft diagonal gradient (~0.16
                 peak), sized to stay inside the pill. It used to be a SOLID
                 #29FFFFFF slab 120px tall rotated 120° inside a 64px bar, so it
                 overshot the pill's bounds and rendered as a hard-edged block —
                 the artefact on the player bar. Ignore pointer input so the
                 sheen never steals clicks from the controls beneath it. -->
            <Rectangle x:Name="PlayerBarSpecular"
                       Grid.Column="0" Grid.ColumnSpan="4"
                       Width="160" Height="64"
                       RadiusX="18" RadiusY="18"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#29FFFFFF" Offset="0.45" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Art + title/artist: one click target that opens Now Playing. -->
            <Button x:Name="PlayerBarExpand"
                    Grid.Column="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    AutomationProperties.Name="Open Now Playing"
                    Click="PlayerBarExpand_Click">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border x:Name="BarArt"
                            Width="44" Height="44"
                            CornerRadius="8"
                            Background="{ThemeResource RaisedBrush}" />
                    <StackPanel VerticalAlignment="Center" Spacing="1" MaxWidth="220">
                        <!-- The bar is only 220px wide, so both lines trim — the
                             tooltip is what keeps the FULL metadata reachable. -->
                        <TextBlock x:Name="BarTitle"
                                   Text="{x:Bind Player.TrackTitle, Mode=OneWay}"
                                   ToolTipService.ToolTip="{x:Bind Player.TrackTitle, Mode=OneWay}"
                                   Style="{StaticResource CardTitleText}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="BarArtist"
                                   Text="{x:Bind Player.TrackArtist, Mode=OneWay}"
                                   ToolTipService.ToolTip="{x:Bind Player.TrackArtist, Mode=OneWay}"
                                   Style="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Seek: single bar with buffered segment; times only, never bytes. -->
            <Grid Grid.Column="1" ColumnSpacing="10" Margin="16,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BarPositionText" Grid.Column="0" Text="–:––"
                           Style="{StaticResource MutedText}" VerticalAlignment="Center" MinWidth="46" />
                <!-- Enabled only while a seek can actually land (x:Bind): seeking
                     needs a loaded source, and PlaybackService.Seek declines while a
                     track is still resolving and after it has finished — so gating on
                     HasTrack alone accepted drags that did nothing. -->
                <controls:BufferedSeekBar x:Name="BarSeekBar" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsEnabled="{x:Bind Player.CanSeek, Mode=OneWay}"
                                          SeekRequested="BarSeekBar_SeekRequested"
                                          PreviewChanged="BarSeekBar_PreviewChanged"
                                          AutomationProperties.Name="Seek bar" />
                <TextBlock x:Name="BarDurationText" Grid.Column="2" Text="–:––"
                           Style="{StaticResource MutedText}" VerticalAlignment="Center" MinWidth="46"
                           TextAlignment="Right" />
            </Grid>

            <!-- Transport -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="BarPrevButton" Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="Previous"
                        IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                        Click="BarPrevButton_Click">
                    <FontIcon Glyph="&#xE892;" FontSize="16" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <Button x:Name="BarPlayButton"
                        Width="44" Height="44" CornerRadius="22"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Play or pause"
                        IsEnabled="{x:Bind Player.CanToggle, Mode=OneWay}"
                        Click="BarPlayButton_Click">
                    <TextBlock x:Name="BarPlayGlyph"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16" Text="{x:Bind Player.PlayGlyph, Mode=OneWay}" />
                </Button>
                <Button x:Name="BarNextButton" Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="Next"
                        IsEnabled="{x:Bind Queue.CanAdvance, Mode=OneWay}"
                        Click="BarNextButton_Click">
                    <FontIcon Glyph="&#xE893;" FontSize="16" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
            </StackPanel>

            <!-- Volume: perceptual curve applied in code-behind. -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button x:Name="BarMuteButton" Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="Mute"
                        Click="BarMuteButton_Click">
                    <FontIcon x:Name="BarMuteGlyph"
                              Glyph="&#xE767;" FontSize="16" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <Slider x:Name="BarVolumeSlider"
                        Width="90" Minimum="0" Maximum="100" StepFrequency="1"
                        Value="{x:Bind Player.VolumePercent, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Volume"
                        ValueChanged="BarVolumeSlider_ValueChanged">
                    <!-- Accent comes from the token, not a second copy of the hex.
                         These were seven hard-coded # FA2D48 values duplicating
                         AccentColor, so a change to the accent (or a future
                         artwork-derived accent) silently left the volume slider
                         behind on the old colour. -->
                    <Slider.Resources>
                        <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource AccentColor}" />
                        <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="{StaticResource AccentColor}" />
                        <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="{StaticResource AccentColor}" />
                        <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource AccentColor}" />
                        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource AccentColor}" />
                        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource AccentColor}" />
                        <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="{StaticResource AccentColor}" />
                    </Slider.Resources>
                </Slider>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
