<Page x:Class="YtMusicClient.Views.NowPlayingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource AppBackgroundBrush}"
      NavigationCacheMode="Enabled">

    <StackPanel Padding="32,24" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Nothing playing"
                   Style="{StaticResource PageHeadlineText}"
                   HorizontalAlignment="Center" />
        <TextBlock Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                   Text="Start a track from Home or Search and the queue fan carousel will appear here." />
        <TextBlock Text="{x:Bind ViewModel.AuthStatusText, Mode=OneWay}"
                   Style="{StaticResource MutedText}"
                   HorizontalAlignment="Center" />
    </StackPanel>
</Page>
