<Page x:Class="YtMusicClient.Views.NowPlayingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:YtMusicClient.Views.Controls"
      xmlns:services="using:YtMusicClient.Services"
      Background="Transparent"
      NavigationCacheMode="Enabled"
      Loaded="NowPlayingPage_OnLoaded"
      SizeChanged="Page_SizeChanged"
      Unloaded="NowPlayingPage_OnUnloaded">

    <Grid>
        <Image x:Name="AmbientArt"
               Stretch="UniformToFill"
               Opacity="0.3"
               Visibility="Collapsed">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1.35" ScaleY="1.35" />
            </Image.RenderTransform>
        </Image>
        <Rectangle x:Name="AmbientOverlay"
                   Fill="#E6000000"
                   Visibility="Collapsed" />

        <Grid Padding="24,16">
            <!-- Empty state: nothing has been started yet -->
            <StackPanel x:Name="EmptyState"
                        Spacing="16"
                        Visibility="{x:Bind Player.EmptyStateVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <FontIcon Glyph="&#xE768;"
                          FontSize="34"
                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                          Foreground="{ThemeResource TextMutedBrush}" />
                <TextBlock Text="Nothing playing"
                           Style="{StaticResource PageHeadlineText}"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                           Text="Start a track from Home, Search or your Liked songs and it shows up here." />
                <TextBlock Text="{x:Bind ViewModel.AuthStatusText, Mode=OneWay}"
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Unified Now Playing Panel — wrapped in a vertical scroller so a
                 compact-height window scrolls instead of clipping the transport
                 (the old panel was VerticalAlignment=Center with all-Auto rows
                 and no scroller: anything taller than the viewport clipped at
                 BOTH ends). Visibility lives on the scroller, not the panel, so
                 an empty player leaves no invisible overlay above the empty
                 state. Horizontal scrolling stays disabled: nothing may push
                 the controls sideways out of the window. -->
            <ScrollViewer x:Name="NpScroller"
                          Visibility="{x:Bind Player.PanelVisibility, Mode=OneWay}"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled"
                          ZoomMode="Disabled"
                          IsTabStop="False">
            <Grid x:Name="NowPlayingPanel"
                  MaxWidth="680"
                  HorizontalAlignment="Center"
                  RowSpacing="16"
                  Margin="0,4,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="24" />
                    </TransitionCollection>
                </Grid.ChildrenTransitions>

                <!-- 1. Heading: music note icon + "Now Playing" -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8D6;" FontSize="18" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Now Playing" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 2. Carousel / Main Artwork + Queue Previews -->
                <Grid Grid.Row="1" MaxWidth="660" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Previous track preview card -->
                    <Button x:Name="CarouselPrev"
                            Grid.Column="0"
                            Style="{StaticResource CardButtonStyle}"
                            Width="150" Height="220"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            AutomationProperties.Name="Play previous track"
                            Visibility="Collapsed"
                            Click="PrevButton_Click">
                        <Border CornerRadius="14"
                                Background="{ThemeResource GlassStrongBrush}"
                                BorderBrush="{ThemeResource TokenBorderStrongBrush}"
                                BorderThickness="1"
                                Opacity="0.6">
                            <StackPanel>
                                <Border x:Name="CarouselPrevArt"
                                        Width="148" Height="148"
                                        CornerRadius="13,13,0,0"
                                        Background="{ThemeResource RaisedBrush}" />
                                <StackPanel Margin="6,6,6,6" HorizontalAlignment="Center">
                                    <TextBlock x:Name="CarouselPrevTitle"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               TextAlignment="Center" />
                                    <TextBlock x:Name="CarouselPrevArtist"
                                               FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Current focal card -->
                    <Border x:Name="CarouselCurrentCard"
                            Grid.Column="1"
                            Width="300"
                            CornerRadius="20"
                            Background="{ThemeResource GlassStrongBrush}"
                            BorderBrush="{ThemeResource TokenBorderStrongBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <Border x:Name="CarouselCurrentArt"
                                Width="298" Height="298"
                                CornerRadius="19"
                                Background="{ThemeResource RaisedBrush}" />
                    </Border>

                    <!-- Next track preview card -->
                    <Button x:Name="CarouselNext"
                            Grid.Column="2"
                            Style="{StaticResource CardButtonStyle}"
                            Width="150" Height="220"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            AutomationProperties.Name="Play next track"
                            Visibility="Collapsed"
                            Click="NextButton_Click">
                        <Border CornerRadius="14"
                                Background="{ThemeResource GlassStrongBrush}"
                                BorderBrush="{ThemeResource TokenBorderStrongBrush}"
                                BorderThickness="1"
                                Opacity="0.6">
                            <StackPanel>
                                <Border x:Name="CarouselNextArt"
                                        Width="148" Height="148"
                                        CornerRadius="13,13,0,0"
                                        Background="{ThemeResource RaisedBrush}" />
                                <StackPanel Margin="6,6,6,6" HorizontalAlignment="Center">
                                    <TextBlock x:Name="CarouselNextTitle"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               TextAlignment="Center" />
                                    <TextBlock x:Name="CarouselNextArtist"
                                               FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>

                <!-- 3. Track Info, Controls & Seek Bar (Unified Composition) -->
                <StackPanel Grid.Row="2" Spacing="14" HorizontalAlignment="Center" MaxWidth="520">
                    <!-- Title & Artist -->
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="CurrentTitle"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                   TextWrapping="WrapWholeWords"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2"
                                   TextAlignment="Center"
                                   ToolTipService.ToolTip="{x:Bind Player.TrackTitle, Mode=OneWay}" />
                        <TextBlock x:Name="CurrentArtist"
                                   FontSize="15"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   TextAlignment="Center"
                                   ToolTipService.ToolTip="{x:Bind Player.TrackArtist, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Status line -->
                    <TextBlock x:Name="StatusText"
                               Text="{x:Bind Player.StatusText, Mode=OneWay}"
                               Visibility="{x:Bind Player.StatusVisibility, Mode=OneWay}"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <!-- Primary Transport Controls (Shuffle, Prev, Play/Pause, Next, Repeat) -->
                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="ShuffleButton"
                                Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="Shuffle"
                                Click="ShuffleButton_Click">
                            <FontIcon x:Name="ShuffleGlyph" Glyph="&#xE8B1;" FontSize="18"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                      Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="Previous track"
                                IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                                Click="PrevButton_Click">
                            <FontIcon Glyph="&#xE892;" FontSize="22"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>

                        <Button Width="56" Height="56"
                                CornerRadius="28"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="Play or pause"
                                IsEnabled="{x:Bind Player.CanToggle, Mode=OneWay}"
                                Click="PlayPause_Click">
                            <TextBlock x:Name="PlayPauseGlyph"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind Player.PlayGlyph, Mode=OneWay}" />
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="Next track"
                                IsEnabled="{x:Bind Queue.CanAdvance, Mode=OneWay}"
                                Click="NextButton_Click">
                            <FontIcon Glyph="&#xE893;" FontSize="22"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>

                        <Button x:Name="RepeatButton"
                                Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="Repeat"
                                Click="RepeatButton_Click">
                            <FontIcon x:Name="RepeatGlyph" Glyph="&#xE8EE;" FontSize="18"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                      Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>

                    <!-- Seek Bar & Timeline -->
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PositionText"
                                   Grid.Column="0"
                                   Text="0:00"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   MinWidth="46" />

                        <controls:BufferedSeekBar x:Name="SeekBar"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  IsEnabled="{x:Bind Player.CanSeek, Mode=OneWay}"
                                                  SeekRequested="SeekBar_SeekRequested"
                                                  PreviewChanged="SeekBar_PreviewChanged"
                                                  AutomationProperties.Name="Seek bar" />

                        <TextBlock x:Name="DurationText"
                                   Grid.Column="2"
                                   Text="0:00"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   MinWidth="46"
                                   TextAlignment="Right" />
                    </Grid>

                    <!-- Secondary Controls: Like, Autoplay, Volume -->
                    <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="LikeButton"
                                Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="Like"
                                Click="LikeButton_Click">
                            <FontIcon x:Name="LikeGlyph" Glyph="&#xE735;" FontSize="18"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                      Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Button>

                        <ToggleButton x:Name="AutoplayToggle"
                                      IsChecked="{x:Bind Player.AutoplayOn, Mode=TwoWay}"
                                      Style="{StaticResource GlassPillToggleButton}"
                                      AutomationProperties.Name="Autoplay">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B5;" FontSize="13"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                <TextBlock Text="Autoplay" FontSize="12" />
                            </StackPanel>
                        </ToggleButton>

                        <Button Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="Mute or unmute"
                                Click="PageMuteButton_Click">
                            <FontIcon x:Name="PageMuteGlyph" Glyph="&#xE767;" FontSize="18"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
