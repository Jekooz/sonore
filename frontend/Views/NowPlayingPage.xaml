<Page x:Class="YtMusicClient.Views.NowPlayingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:YtMusicClient.Views.Controls"
      Background="Transparent"
      NavigationCacheMode="Enabled">

    <!-- Transparent background: the window's black shows through, and the player
         bar stays visible below this page (it lives in the shell, not the page). -->
    <Grid Padding="32,24,32,16">

        <!-- Empty state: nothing has been started yet -->
        <StackPanel x:Name="EmptyState"
                    Spacing="16"
                    Visibility="{x:Bind Player.EmptyStateVisibility, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="Nothing playing"
                       Style="{StaticResource PageHeadlineText}"
                       HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                       Text="Start a track from Home, Search or your Liked songs — the player bar at the bottom controls playback from any screen." />
            <TextBlock Text="{x:Bind ViewModel.AuthStatusText, Mode=OneWay}"
                       Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Now playing: centered artwork, metadata, one seek bar, full transport -->
        <StackPanel x:Name="NowPlayingPanel"
                    Spacing="14"
                    MaxWidth="560"
                    Visibility="{x:Bind Player.PanelVisibility, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Fixed square + UniformToFill + centered alignment: never clipped
                 off-center, never circle-cropped (artwork is an album, not an artist). -->
            <Border CornerRadius="{StaticResource CardCornerRadius}"
                    Width="300" Height="300"
                    Background="{ThemeResource CardBrush}"
                    HorizontalAlignment="Center">
                <Image x:Name="ArtworkImage"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            </Border>

            <TextBlock x:Name="TitleText"
                       Text="{x:Bind Player.TrackTitle, Mode=OneWay}"
                       Style="{StaticResource PageHeadlineText}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1" />

            <TextBlock x:Name="ArtistText"
                       Text="{x:Bind Player.TrackArtist, Mode=OneWay}"
                       Visibility="{x:Bind Player.ArtistVisibility, Mode=OneWay}"
                       Style="{StaticResource SecondaryText}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1" />

            <!-- Quiet status line for resolve/parse errors only — never byte counts. -->
            <TextBlock x:Name="StatusText"
                       Text="{x:Bind Player.StatusText, Mode=OneWay}"
                       Visibility="{x:Bind Player.StatusVisibility, Mode=OneWay}"
                       Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="460" />

            <!-- The ONE seek bar (buffered segment included). Times only. -->
            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PositionText"
                           Grid.Column="0"
                           Text="0:00"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           MinWidth="34" />

                <controls:BufferedSeekBar x:Name="SeekBar"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          SeekRequested="SeekBar_SeekRequested"
                                          PreviewChanged="SeekBar_PreviewChanged"
                                          AutomationProperties.Name="Seek bar" />

                <TextBlock x:Name="DurationText"
                           Grid.Column="2"
                           Text="0:00"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           MinWidth="34"
                           TextAlignment="Right" />
            </Grid>

            <!-- Full transport: prev / play / next; shuffle and like arrive with
                 the queue + like endpoints (backend work, flagged to the user). -->
            <StackPanel Orientation="Horizontal"
                        Spacing="20"
                        HorizontalAlignment="Center">
                <Button x:Name="PrevButton"
                        Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="Previous track"
                        IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                        Click="PrevButton_Click">
                    <FontIcon Glyph="&#xE892;" FontSize="18" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>

                <Button x:Name="PlayPauseButton"
                        Width="64" Height="64"
                        CornerRadius="32"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Play or pause"
                        IsEnabled="{x:Bind Player.CanToggle, Mode=OneWay}"
                        Click="PlayPause_Click">
                    <TextBlock x:Name="PlayPauseGlyph"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="22"
                               Text="{x:Bind Player.PlayGlyph, Mode=OneWay}" />
                </Button>

                <Button x:Name="NextButton"
                        Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="Next track"
                        IsEnabled="{x:Bind Queue.HasUpcoming, Mode=OneWay}"
                        Click="NextButton_Click">
                    <FontIcon Glyph="&#xE893;" FontSize="18" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
