<Page x:Class="YtMusicClient.Views.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="using:YtMusicClient.Services"
      Background="{ThemeResource AppBackgroundBrush}"
      NavigationCacheMode="Enabled">

    <StackPanel Padding="32,24" Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">
        <TextBox x:Name="SearchBox"
                 PlaceholderText="Search songs, albums, artists…"
                 CornerRadius="10"
                 MinHeight="40"
                 KeyDown="SearchBox_KeyDown" />

        <StackPanel Orientation="Horizontal" Spacing="12">
            <ProgressRing x:Name="LoadingRing" Width="24" Height="24" IsActive="False" />
            <TextBlock x:Name="ErrorText"
                       Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>

        <TextBlock x:Name="ResultsPlaceholder"
                   Style="{StaticResource SecondaryText}"
                   Text="Type to search YouTube Music." />

        <ItemsControl x:Name="ResultsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="services:SearchResultItemView">
                    <Grid ColumnSpacing="12" Margin="0,4" MinHeight="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="6" Background="{ThemeResource GlassBrush}">
                            <Image Stretch="UniformToFill"
                                   Source="{x:Bind ThumbnailUrl, Mode=OneWay}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Title}"
                                       Style="{StaticResource CardTitleText}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{x:Bind Artist}"
                                       Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                CornerRadius="9"
                                Background="{ThemeResource GlassStrongBrush}"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ResultType}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
