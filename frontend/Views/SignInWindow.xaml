<Window x:Class="YtMusicClient.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Glass chrome header consistent with MainWindow -->
        <Grid Grid.Row="0"
              Height="48"
              Background="{ThemeResource GlassBrush}"
              BorderBrush="{ThemeResource TokenBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="22" Height="22"
                    CornerRadius="6"
                    Background="{ThemeResource AccentBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0" />
            <TextBlock Grid.Column="0"
                       Text="YT"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />

            <TextBlock Grid.Column="1"
                       Text="Sign in with Google"
                       Style="{StaticResource SectionHeaderText}"
                       VerticalAlignment="Center" />

            <TextBlock x:Name="StatusText"
                       Grid.Column="2"
                       Text=""
                       Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Embedded Google sign-in. Cookies are captured from this profile —
             no external browser, no codes to copy anywhere. -->
        <WebView2 x:Name="SignInWebView"
                  Grid.Row="1"
                  Source="https://music.youtube.com"
                  NavigationStarting="SignInWebView_NavigationStarting"
                  NavigationCompleted="SignInWebView_NavigationCompleted"
                  DefaultBackground="Black" />
    </Grid>
</Window>
